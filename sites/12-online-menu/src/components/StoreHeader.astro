---
import { navAnchors } from '../lib/content';

interface Props {
  logo: string;
  nav: string[];
  account: string;
  cart: { label: string; count: number };
}

const { logo, nav, account, cart } = Astro.props;
---

<header class="store-header" id="topo">
  <div class="store-header__left">
    <button class="store-header__expander" type="button" aria-expanded="false" aria-controls="store-menu">
      <span aria-hidden="true">+</span>
      <span class="visually-hidden">Abrir menu</span>
    </button>
    <nav aria-label="Principal" class="store-header__nav">
      <ul>
        {nav.map((label, i) => <li><a href={navAnchors[i] ?? '#'}>{label}</a></li>)}
      </ul>
    </nav>
  </div>

  <a class="store-header__logo" href="/">{logo}</a>

  <div class="store-header__right">
    <a href="#rodape" class="store-header__icon">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg>
      <span class="visually-hidden">{account}</span>
    </a>
    <a href="#produtos" class="store-header__icon">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 8h14l-1 13H6L5 8Z"></path><path d="M9 8V6a3 3 0 0 1 6 0v2"></path></svg>
      <span class="visually-hidden">{cart.label}</span>
      <span class="store-header__count" aria-label={`${cart.count} itens`}>{cart.count}</span>
    </a>
  </div>

  <div class="store-menu" id="store-menu" hidden>
    <ul>
      {nav.map((label, i) => <li><a href={navAnchors[i] ?? '#'}>{label}</a></li>)}
      <li><a href="#rodape">{account}</a></li>
    </ul>
  </div>
</header>

<script>
  const expander = document.querySelector<HTMLButtonElement>('.store-header__expander');
  const menu = document.getElementById('store-menu');
  if (expander && menu) {
    const setOpen = (open: boolean) => {
      expander.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
    };
    expander.addEventListener('click', () => setOpen(expander.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        expander.focus();
      }
    });
  }
</script>

<style>
  .store-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-block-size: var(--header-height);
    padding-inline: var(--space-lg);
  }

  .store-header__left {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .store-header__expander {
    position: relative;
    z-index: calc(var(--z-menu) + 1);
    padding: var(--space-xs) var(--space-sm);
    background: none;
    border: 0;
    font-size: var(--text-nav);
    line-height: 1;
    cursor: pointer;
    transition: transform var(--duration-fast);
  }

  .store-header__expander[aria-expanded='true'] {
    transform: rotate(45deg);
  }

  .store-header__nav {
    display: none;
  }

  .store-header__nav ul,
  .store-menu ul {
    display: flex;
    gap: var(--space-xl);
    padding: 0;
    list-style: none;
  }

  .store-header a {
    text-decoration: none;
  }

  .store-header__nav a {
    font-size: var(--text-nav);
    font-weight: 300;
  }

  .store-header a:hover {
    opacity: var(--opacity-hover);
  }

  .store-header__logo {
    font-family: var(--font-display);
    font-size: var(--logo-size);
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .store-header__right {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-lg);
  }

  .store-header__icon {
    position: relative;
    display: inline-flex;
  }

  .store-header__count {
    position: absolute;
    inset-block-start: calc(-1 * var(--space-xs));
    inset-inline-end: calc(-1 * var(--space-xs));
    font-size: var(--text-xs);
  }

  .store-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--color-white) 92%, transparent);
  }

  .store-menu[hidden] {
    display: none;
  }

  .store-menu ul {
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .store-menu a {
    font-size: var(--text-menu);
  }

  @media (min-width: 810px) {
    .store-header__nav {
      display: block;
    }
  }
</style>
